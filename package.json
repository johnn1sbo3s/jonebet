{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:tailwind": "node scripts/check-arbitrary-values.cjs app/",
    "backend": "json-server --watch db/db.json --port 5000",
    "test:unit": "vitest run",
    "prepare": "husky"
  },
  "dependencies": {
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/ui": "^4.8.2",
    "@nuxtjs/device": "^3.2.4",
    "@pinia/nuxt": "^0.5.4",
    "chart.js": "^3.9.1",
    "chartjs-plugin-annotation": "^2.2.1",
    "chartjs-plugin-zoom": "^2.0.1",
    "json-server": "^1.0.0-alpha.23",
    "luxon": "^3.4.4",
    "nuxt": "^4.4.7",
    "pinia": "^2.2.2",
    "tailwindcss": "^4.3.0",
    "vue": "^3.4.21",
    "vue-chart-3": "^3.1.8",
    "vue-router": "^4.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.111",
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/eslint-config": "^1.15.2",
    "@nuxt/test-utils": "^4.0.3",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "happy-dom": "^20.10.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "vitest": "^4.1.8"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{vue,ts}": "node scripts/check-arbitrary-values.cjs"
  },
  "pnpm": {
    "overrides": {
      "picomatch": "2.3.2",
      "esbuild": "0.28.1"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "unrs-resolver",
      "vue-demi"
    ]
  }
}
