{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1",
      "brace-expansion": "5.0.9",
      "nanoid": "^3.3.18"
    }
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:tailwind": "node scripts/check-arbitrary-values.cjs app/",
    "test:unit": "vitest run",
    "prepare": "husky"
  },
  "dependencies": {
    "@internationalized/date": "3.12.3",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/ui": "^4.11.0",
    "@nuxtjs/device": "^3.2.4",
    "@vite-pwa/nuxt": "1.1.1",
    "chart.js": "^4.5.1",
    "chartjs-plugin-annotation": "^3.1.0",
    "chartjs-plugin-zoom": "^2.2.0",
    "html-to-image": "^1.11.13",
    "luxon": "^3.7.2",
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.41",
    "vue-chart-3": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.121",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/test-utils": "^4.1.0",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.11.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{vue,ts}": "node scripts/check-arbitrary-values.cjs"
  }
}
